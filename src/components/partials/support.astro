---
import { stl } from "helpers/common";

interface Link {
  label: string;
  href: string;
}

interface Props {
  heading?: string;
  sponsorTitle?: string;
  sponsorText?: string;
  sponsors?: Link[];
  hireTitle?: string;
  hireText?: string;
  hireLabel?: string;
  hireHref?: string;
}

const {
  heading = "Support",
  sponsorTitle = "Sponsor 0build",
  sponsorText = "Help keep it free, maintained and shipping.",
  sponsors = [
    {
      label: "GitHub Sponsors",
      href: "https://github.com/sponsors/sveltecult",
    },
    { label: "Ko-fi", href: "https://ko-fi.com/sveltecult" },
  ],
  hireTitle = "Need a hand with your project?",
  hireText = "I'm available for freelance full-stack development work.",
  hireLabel = "Hire me",
  hireHref = "mailto:reden@franken-ui.dev",
} = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<ul
  class="z-nav z-nav-default mx mt"
  style={stl({ "--mx": "-1", "--mt": "4" })}
  data-z-nav="collapsible: false"
>
  <li class="z-nav-header">{heading}</li>
</ul>

<div class="space-y mt" style={stl({ "--space-y": "3", "--mt": "1" })}>
  <div class="z-card z-card-body">
    <div class="display-flex items-center gap" style={stl({ "--gap": "2" })}>
      <z-icon
        class="size flex-none color"
        style={stl({ "--size": "4", "--color": "var(--z-danger-f)" })}
        icon="heart"
      />
      <span class="font-semibold">{sponsorTitle}</span>
    </div>
    <p
      class="color mt"
      style={stl({ "--color": "var(--z-muted-f)", "--mt": "2" })}
    >
      {sponsorText}
    </p>

    <div
      class="mt space-y"
      style={stl({ "--mt": "4", "--space-y": "2" })}
    >
      {
        sponsors.map((s) => (
            <a
              class="z-button z-button-default w-full"
              href={s.href}
              target={isExternal(s.href) ? "_blank" : undefined}
              rel={isExternal(s.href) ? "noopener noreferrer" : undefined}
            >
              <span>{s.label}</span>
            </a>
        ))
      }
      </div>
  </div>

  <div class="z-card z-card-secondary p" style={stl({ "--p": "4" })}>
    <p class="font-semibold">{hireTitle}</p>
    <p
      class="color mt"
      style={stl({ "--color": "var(--z-muted-f)", "--mt": "2" })}
    >
      {hireText}
    </p>
    <a
      class="z-button z-button-primary w-full mt"
      style={stl({ "--mt": "3" })}
      href={hireHref}
      target={isExternal(hireHref) ? "_blank" : undefined}
      rel={isExternal(hireHref) ? "noopener noreferrer" : undefined}
    >
      <span>{hireLabel}</span>
      <z-icon
        class="size ml"
        style={stl({ "--size": "4", "--ml": "1.5" })}
        icon="arrow-right"
      />
    </a>
  </div>
</div>
