---
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {
  class?: string;
  border?: boolean | "x" | "y";
  noColor?: boolean;
}

const { class: cls, border = false, noColor = false, ...rest } = Astro.props;
---

<div
  class:list={[
    "stripes-container",
    {
      "stripes-all": border === true,
      "stripes-x": border === "x",
      "stripes-y": border === "y",
      "has-default-color": !noColor,
    },
    cls,
  ]}
  {...rest}
>
  <slot />
</div>
