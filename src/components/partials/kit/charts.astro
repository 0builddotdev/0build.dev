---
import { stl } from "helpers/common";

const { version = "latest" } = Astro.props;

const charts = [
  {
    slug: "chart-area",
    title: "Area Chart",
    description:
      "An area chart visually represents data over time, displaying trends and patterns through filled-in areas under a line graph.",
  },
  {
    slug: "chart-line",
    title: "Line Chart",
    description:
      "A line chart visually displays data points connected by straight lines, illustrating trends or relationships over a continuous axis.",
  },
];
---

<div class="docs-grid mt" style={stl({ "--mt": "10" })}>
  <span class="docs-grid-corner docs-grid-corner--tl"></span>
  <span class="docs-grid-corner docs-grid-corner--tr"></span>
  <span class="docs-grid-corner docs-grid-corner--bl"></span>
  <span class="docs-grid-corner docs-grid-corner--br"></span>

  <div class="docs-grid-items docs-grid-items--cols-2">
    {
      charts.map((chart) => (
        <div
          class="docs-grid-card p relative"
          style={stl({
            "--p": "6",
          })}
        >
          <a
            href={`/docs/${version}/kit/${chart.slug}`}
            class="z-text-medium font-semibold"
          >
            {chart.title}
            <span class="absolute inset" style={stl({ "--inset": "0" })} />
          </a>
          <p
            class="mt"
            style={stl({
              "--mt": "6",
            })}
          >
            {chart.description}
          </p>
        </div>
      ))
    }
  </div>
</div>
